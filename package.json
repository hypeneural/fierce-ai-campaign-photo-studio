    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.3",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "npm@10.8.2"
